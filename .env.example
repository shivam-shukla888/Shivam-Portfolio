# Canonical Production Deployment URL
NEXT_PUBLIC_SITE_URL=https://www.jiosi.online

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Single Admin Authorization (Supabase Auth User UUID)
SHIVSASTRA_ADMIN_USER_ID=

# Cloudflare Turnstile Configuration (Managed Mode)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=

# Upstash Redis Configuration (Distributed Rate Limiting - Server Only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dedicated Server-Side Rate Limiting Salt (Required in Production - High-Entropy Secret)
RATE_LIMIT_SALT=

# Resend Email Integration (Server Only)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_AUTO_REPLY_ENABLED=false


# Groq AI Configuration (Server Only)
GROQ_API_KEY=
GROQ_MODEL=

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
